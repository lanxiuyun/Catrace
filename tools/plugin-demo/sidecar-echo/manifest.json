{
  "id": "sidecar-echo",
  "name": "Sidecar Capability Demo",
  "version": "0.3.0",
  "description": "完整验证 sidecar、环境变量、文件/目录选择、启动程序与 HTTP GET",
  "main": "ui.mjs",
  "settings": "settings.mjs",
  "events": ["sidecar-echo", "kind:sidecar-echo", "sidecar-echo.tick", "sidecar-echo.notification"],
  "enabledByDefault": false,
  "sidecar": {
    "command": "node",
    "args": ["runtime/main.mjs"],
    "cwd": "."
  }
}
