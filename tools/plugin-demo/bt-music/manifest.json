{
  "id": "bt-music",
  "name": "蓝牙听歌",
  "version": "0.2.2",
  "description": "监听蓝牙耳机连接，快速弹窗并启动指定音乐软件",
  "main": "ui.mjs",
  "settings": "settings.mjs",
  "events": [
    "bt-music",
    "kind:bt-music",
    "bt-music.connected",
    "bt-music.disconnected"
  ],
  "enabledByDefault": false,
  "sidecar": {
    "command": "node",
    "args": ["runtime/main.mjs"],
    "cwd": "."
  }
}
